{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bethink/petition-names",
	"version": "0.3.2",
	"title": "Petition Names",
	"category": "widgets",
	"icon": "groups",
	"description": "A block to display a list of names from a Gravity Forms petition.",
	"example": {},
	"supports": {
		"html": false
	},
	"textdomain": "petition-names",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./frontend.js",
	"render": "file:./render.php",
	"attributes": {
		"formId": {
			"type": "string",
			"default": ""
		},
		"nameFieldId": {
			"type": "string",
			"default": ""
		},
		"pinnedEntryIds": {
			"type": "array",
			"default": [],
			"items": {
				"type": "number"
			}
		},
		"itemsPerPage": {
			"type": "number",
			"default": 60
		},
		"columnWidth": {
			"type": "number",
			"default": 125
		},
		"showGravatars": {
			"type": "boolean",
			"default": false
		},
		"emailFieldId": {
			"type": "string",
			"default": ""
		}
	}
}
